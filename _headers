# Browser caching. Photos are cached for a day and quietly refreshed in the background for a week,
# so a replaced photo shows up within a day while repeat visitors load pages faster.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.*
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
